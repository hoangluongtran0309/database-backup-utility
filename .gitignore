# Maven's build output, and only that. Anchored on purpose: an unanchored
# `target/` also matched the source package application/.../target/, which
# kept the target use cases out of the repository without anyone noticing.
/target/
/*/target/
!.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml
.vscode/
.classpath
.project
.settings/

*.log
.DS_Store

# Default dbbackup.storage.local.root — real dumps, never commit them.
# Not anchored to the repository root: `./backups` resolves against whatever
# working directory the process has, and `mvn -pl web spring-boot:run` puts it
# under web/. A production deployment sets BACKUP_DIR to an absolute path
# outside the checkout.
backups/

# Default SQLITE_ROOT. Anchored so adapter packages named `sqlite` stay tracked.
/sqlite/
/web/sqlite/

# Operator-supplied Oracle packages and the default shared staging directory.
# Neither client binaries nor Data Pump files belong in source control.
/oracle-client/
/oracle-client-unpacked/
/.oracle-client-fixture/
/oracle-datapump/
/web/oracle-datapump/

# SqlPackage table-data staging. Each job directory is short-lived; the root
# remains on disk and may be configured outside the checkout in production.
/sqlserver-temp/
/web/sqlserver-temp/

# Never commit a real encryption key or datasource password.
.env
.env.local

# Local, tickable implementation ledger. ROADMAP.md is the shared high-level
# plan; this file is deliberately allowed to change after every small step.
/FEATURE_PARITY.local.md
