<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.hoangluongtran0309</groupId>
  <artifactId>database-backup-utility</artifactId>
  <version>0.21.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>database-backup-utility</name>
  <description>Multi-database logical backup and restore, driven from a web console or operator CLI</description>

  <modules>
    <module>core</module>
    <module>adapters</module>
    <module>application</module>
    <module>web</module>
    <module>cli</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Mockito 5's inline mock maker must start as an agent on JDK 21.
         Self-attachment is disabled by several supported JDK distributions. -->
    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
    <!-- Ahead of Spring Boot 4.1.1's managed 2.21.5 / 3.1.5: CVE-2026-68497,
         CVE-2026-91776 and CVE-2026-91777 in jackson-databind. Drop these once
         the Boot parent manages these versions or newer. -->
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <aws.sdk.version>2.54.20</aws.sdk.version>
    <google.cloud.storage.version>2.71.0</google.cloud.storage.version>
    <azure.sdk.bom.version>1.3.8</azure.sdk.bom.version>
    <!-- Spring Boot 4.1.1 manages 11.0.24; 11.0.25 contains the fixes for
         CVE-2026-65182, CVE-2026-65905 and CVE-2026-68525. -->
    <tomcat.version>11.0.25</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-sdk-bom</artifactId>
        <version>${azure.sdk.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
